# Run make init to generate .env with random local secrets.
POSTGRES_PASSWORD=replace-with-random-database-password
OPERATOR_API_KEY=replace-with-at-least-32-random-characters
SIGNING_SECRET=replace-with-another-32-random-characters
DATABASE_URL=postgresql+psycopg://relay:replace-with-random-database-password@db:5432/relay
DESTINATION_URL=http://receiver:8001/webhooks
DEMO_MODE=true
# production: jittered 5/15/45/120s; demo: accelerated 2/4/8/12s
RETRY_PROFILE=production
REQUEST_DEADLINE=10
LEASE_DURATION=60
PUBLIC_BASE_URL=http://localhost:8000
# Stop new demo runs at this total PostgreSQL database size (256 MiB).
DEMO_STORAGE_LIMIT_BYTES=268435456
# JSON list of explicit proxy peer CIDRs; empty ignores forwarded client identities.
TRUSTED_PROXY_CIDRS=[]
