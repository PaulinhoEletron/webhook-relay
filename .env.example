# Run make init to generate .env with random local secrets.
POSTGRES_PASSWORD=replace-with-random-database-password
OPERATOR_API_KEY=replace-with-at-least-32-random-characters
SIGNING_SECRET=replace-with-another-32-random-characters
DATABASE_URL=postgresql+psycopg://relay:replace-with-random-database-password@db:5432/relay
# Webhook delivery target; must be https except the bundled demo receiver.
DESTINATION_URL=http://receiver:8001/webhooks
# Enables the public demo endpoints and page.
DEMO_MODE=true
# production: jittered 5/15/45/120s; demo: accelerated 2/4/8/12s
RETRY_PROFILE=production
# Per-attempt delivery timeout in seconds (max 10).
REQUEST_DEADLINE=10
# Seconds a worker holds a delivery before it can be recovered (min 60).
LEASE_DURATION=60
# Externally visible base URL of the API.
PUBLIC_BASE_URL=http://localhost:8000
# Stop new demo runs at this total PostgreSQL database size (256 MiB).
DEMO_STORAGE_LIMIT_BYTES=268435456
# Trust the CF-Connecting-IP header for client identity. Enable only when the API is reachable
# exclusively through the Cloudflare tunnel; otherwise the TCP peer is used.
TRUST_CF_CONNECTING_IP=false
# Total seconds allowed to receive a request body before answering 408 (max 60).
BODY_READ_TIMEOUT=10
# Public source repository linked from the demo page (https URL); empty hides the link.
SOURCE_URL=https://github.com/PaulinhoEletron/webhook-relay
# Internal Prometheus listeners (inside the containers, never published): API and worker. 0 disables.
METRICS_PORT=9090
WORKER_METRICS_PORT=9091
